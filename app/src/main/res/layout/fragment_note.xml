<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="15dp"
    android:paddingTop="20dp"
    tools:context=".ui.fragments.note.NoteFragment"
    android:background="#252525">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_menu"
        android:layout_width="17dp"
        android:layout_height="12dp"
        android:layout_marginLeft="20dp"
        android:background="@drawable/menu"
        app:layout_constraintBottom_toBottomOf="@+id/txt_tittle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_tittle" />

    <TextView
        android:id="@+id/txt_tittle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Все заметки"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="18dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/txt_tittle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_tittle"
        android:layout_marginEnd="20dp"
        android:background="@drawable/shape"/>

    <EditText
        android:id="@+id/et_search"
        android:layout_width="320dp"
        android:layout_height="40dp"
        android:background="@drawable/rounded_et"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_tittle"
        android:layout_marginTop="29dp"
        android:paddingStart="16dp"
        android:hint="Добавить Заметку"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:textColorHint="#2E2E2E"
        android:drawableStart="@drawable/search"
        android:drawablePadding="20dp"
        tools:ignore="HardcodedText,RtlSymmetry" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_plus"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/plus_menu"
        android:layout_marginEnd="23dp"
        android:layout_marginBottom="30dp"/>

    <TextView
        android:id="@+id/txt_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/et_search"
        app:layout_constraintTop_toBottomOf="@+id/et_search"
        android:layout_marginTop="20dp"
        android:textSize="16sp"
        android:textColor="@color/white"
        />

</androidx.constraintlayout.widget.ConstraintLayout>